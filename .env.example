# EasySticker 环境变量（复制为 .env 后填写）
#   cp .env.example .env
# 优先级：真实环境变量 > .env > prompt-config.json > 代码默认值
# .env 不要提交到 Git。

# ── 安全（公网部署必填）────────────────────────────
# API 认证；留空时鉴权关闭（首次空 data 启动会临时用管理员密码作邀请码）
API_TOKEN=
# JWT 签名密钥；不固定会导致重启后所有登录失效
JWT_SECRET=
# 首个管理员密码；留空则每次启动随机生成并打印到日志
ADMIN_PASSWORD=
# 首个管理员邮箱
ADMIN_EMAIL=admin@easysticker.app

# 仅本地开发 / e2e：强制关闭鉴权
# DISABLE_AUTH=

# ── 服务 ──────────────────────────────────────────
PORT=3000
# 监听地址；默认 0.0.0.0
# HOST=0.0.0.0
DATA_DIR=data
LOG_LEVEL=info
# 公网部署改为 production
NODE_ENV=development

# ── 限流与配额 ────────────────────────────────────
RATE_LIMIT_MAX=30
DAILY_QUOTA_MAX=100
DAILY_QUOTA_ANONYMOUS_MAX=10
# 跨域白名单；留空 = 仅同源
CORS_ALLOW_ORIGIN=

# ── AI 提供商密钥 ─────────────────────────────────
# 命名规则：AI_<PROVIDER_ID>_API_KEY，provider id 见 prompt-config.json
# 环境变量优先于配置文件，接口不会回显密钥
AI_SEEDREAM_API_KEY=
AI_OPENAI_API_KEY=

# ── 邮件（密码重置，可选）─────────────────────────
# 不配置时重置链接只打印到服务器日志
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 外部访问地址，用于密码重置链接
BASE_URL=

# 仅 docker-compose.image.yml：锁定镜像版本
# EASYSTICKER_TAG=<版本号>
