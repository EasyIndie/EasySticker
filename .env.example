# EasySticker 环境变量配置
#
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# 注意：.env 文件不要提交到版本控制！

# ── Security ───────────────────────────────────────────────────
# API 认证密钥。强烈建议设置！
# 不设置则认证关闭，任何人可调用 API。
# 也作为管理员邀请码（register mode=invite 时新用户注册需要提供）。
API_TOKEN=

# JWT 签名密钥。建议设置固定值，否则服务重启后所有登录令牌失效。
JWT_SECRET=

# 管理员密码。不设置则每次启动生成随机密码（见启动日志）。
ADMIN_PASSWORD=

# ── Server ─────────────────────────────────────────────────────
# 端口（默认 3000，有反向代理时无需修改）
PORT=3000

# 数据存储目录（默认 ./data）
DATA_DIR=data

# 日志级别（trace/debug/info/warn/error）
LOG_LEVEL=info

# 运行环境（生产环境设为 production）
NODE_ENV=production

# ── Rate Limit & Quota ─────────────────────────────────────────
# 每分钟每 IP 最大 API 请求数（默认 30）
RATE_LIMIT_MAX=30

# 每日每用户最大生成次数（默认 100）
DAILY_QUOTA_MAX=100

# 允许跨域的来源（留空则只允许同源）
CORS_ALLOW_ORIGIN=

# ── SMTP（密码重置，可选）─────────────────────────────────────────
# 不配置 SMTP 时密码重置链接会打印到服务器日志（console 模式）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 管理员邮箱（第一条用户记录使用此邮箱创建）
ADMIN_EMAIL=admin@easysticker.app

# 外部访问地址（用于密码重置链接中的跳转 URL）
# 例如：https://sticker.example.com
BASE_URL=
