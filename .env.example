# EasySticker 环境变量配置
#
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
#
# 注意：.env 文件不要提交到版本控制！
#
# 配置优先级（从高到低）：
#   1. 真实环境变量（shell / 系统 / CI）
#   2. .env 文件（本文件）
#   3. prompt-config.json 的 server.* 段
#   4. 代码默认值
#
# 服务启动时会自动读取项目根目录的 .env（且不会覆盖已有的环境变量）。

# ── Security ───────────────────────────────────────────────────
# API 认证密钥。
# ⚠️ 留空 = 认证关闭，任何人可调用 API（会消耗你的 AI 额度）。
#    本地自测可留空；只要端口会被他人访问（局域网/公网/Docker）就必须设置。
# 也作为管理员邀请码（register mode=invite 时新用户注册需要提供）。
API_TOKEN=

# JWT 签名密钥。建议设置固定值，否则服务重启后所有登录令牌失效。
JWT_SECRET=

# 管理员密码。不设置则每次启动生成随机密码（见启动日志）。
ADMIN_PASSWORD=

# ── Server ─────────────────────────────────────────────────────
# 端口（默认 3000，有反向代理时无需修改）
PORT=3000

# 数据存储目录（默认 ./data）
DATA_DIR=data

# 日志级别（trace/debug/info/warn/error）
LOG_LEVEL=info

# 运行环境：本地开发保持 development（默认，Mock 可见、更友好）。
# ⚠️ 仅当对公网部署时才改为 production；production 下务必同时设置上面的 API_TOKEN，
#    否则 API 无鉴权，任何人都能调用你的生图接口。
NODE_ENV=development

# ── Rate Limit & Quota ─────────────────────────────────────────
# 每分钟每 IP 最大 API 请求数（默认 30）
RATE_LIMIT_MAX=30

# 每日每用户最大生成次数（默认 100）
DAILY_QUOTA_MAX=100
# 匿名用户的每日生成上限（按 IP 计）
DAILY_QUOTA_ANONYMOUS_MAX=10

# 允许跨域的来源（留空则只允许同源）
CORS_ALLOW_ORIGIN=

# ── SMTP（密码重置，可选）─────────────────────────────────────────
# 不配置 SMTP 时密码重置链接会打印到服务器日志（console 模式）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 管理员邮箱（第一条用户记录使用此邮箱创建）
ADMIN_EMAIL=admin@easysticker.app

# 外部访问地址（用于密码重置链接中的跳转 URL）
# 例如：https://sticker.example.com
BASE_URL=

# ── AI Provider Keys（推荐：密钥放这里，避免写入 prompt-config.json）──
# 命名规则：AI_<PROVIDER_ID>_API_KEY（大写，非字母数字转下划线）
# 优先级：环境变量 / .env > prompt-config.json > 代码默认值
#
# provider id 见 prompt-config.json 的 ai.providers 键名。
# 例：id 为 "seedream" 的豆包 Seedream
AI_SEEDREAM_API_KEY=
# 例：id 为 "openai" 的 OpenAI 兼容端点
AI_OPENAI_API_KEY=
