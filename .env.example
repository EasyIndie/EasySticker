# AI 提供商配置
AI_PROVIDER=picsum # 支持: picsum, doubao, huggingface
AI_HTTP_REFERENCE_MODE=base64
AI_PUBLIC_BASE_URL=

# Doubao (Ark) 配置
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seedream-5-0-260128
ARK_API_KEY=your_ark_api_key_here

# HuggingFace 配置
HF_TOKEN=your_huggingface_token_here
HF_MODEL=black-forest-labs/FLUX.1-schnell

# AI 请求与重试配置
AI_REQUEST_TIMEOUT_MS=60000
AI_REQUEST_RETRY_MAX=3
AI_REQUEST_RETRY_BASE_MS=1000

# 图像生成尺寸配置
AI_IMAGE_WIDTH=1024
AI_IMAGE_HEIGHT=1024
