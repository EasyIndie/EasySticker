{
  "name": "easysticker",
  "version": "0.3.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"tsup --watch\" \"node --watch dist/server.js\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite",
    "web:build": "vite build && vite build --config web/vite.auth.config.ts && vite build --config web/vite.preview.config.ts && vite build --config web/vite.generator-api.config.ts && vite build --config web/vite.ui.config.ts && vite build --config web/vite.app.config.ts && vite build --config web/vite.admin.config.ts && node scripts/version-assets.mjs",
    "web:version": "node scripts/version-assets.mjs",
    "web:typecheck": "tsc -p web/tsconfig.json",
    "start": "node dist/server.js",
    "prod": "NODE_ENV=production node dist/server.js",
    "setup": "node scripts/setup.mjs",
    "mock-ai": "node scripts/mock-ai-server.mjs",
    "repair-pack": "node scripts/repair-pack.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "npm run typecheck && npm run web:typecheck && npm run build && node ./node_modules/.bin/vitest run",
    "test:e2e": "playwright test",
    "gc": "npm run build && node dist/cli/gc.js"
  },
  "dependencies": {
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.2.5",
    "archiver": "^7.0.1",
    "fastify": "^5.2.0",
    "http-errors": "^2.0.0",
    "nanoid": "^5.1.2",
    "nodemailer": "^8.0.10",
    "pino": "^10.4.0",
    "sharp": "^0.34.3",
    "undici": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/archiver": "^6.0.3",
    "@types/http-errors": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.0",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.60.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vite": "^5.4.21",
    "vitest": "^3.0.9"
  },
  "description": "AI-powered WeChat sticker auto-production pipeline — upload reference, generate expressions, auto-validate, one-click ZIP export",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/EasyIndie/EasySticker.git"
  },
  "homepage": "https://github.com/EasyIndie/EasySticker#readme",
  "bugs": {
    "url": "https://github.com/EasyIndie/EasySticker/issues"
  },
  "keywords": [
    "wechat",
    "sticker",
    "emoji",
    "ai",
    "expression-pack",
    "opensource",
    "self-hosted"
  ]
}
