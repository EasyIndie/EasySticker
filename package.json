{
  "name": "easysticker",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k \"tsup --watch\" \"node --watch dist/server.js\"",
    "build": "tsup",
    "start": "node dist/server.js",
    "prod": "NODE_ENV=production node dist/server.js",
    "mock-ai": "node scripts/mock-ai-server.mjs",
    "comfy-adapter": "node scripts/comfy-adapter.mjs",
    "test": "npm run build && node ./node_modules/.bin/vitest run"
  },
  "dependencies": {
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.3.0",
    "@fastify/swagger-ui": "^5.2.5",
    "archiver": "^7.0.1",
    "fastify": "^5.2.0",
    "http-errors": "^2.0.0",
    "nanoid": "^5.1.2",
    "nodemailer": "^8.0.10",
    "pino": "^9.6.0",
    "sharp": "^0.34.3",
    "undici": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/http-errors": "^2.0.4",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.0",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "description": "AI-powered WeChat sticker auto-production pipeline — upload reference, generate expressions, auto-validate, one-click ZIP export",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EasyIndie/EasySticker.git"
  },
  "keywords": [
    "wechat",
    "sticker",
    "emoji",
    "ai",
    "expression-pack",
    "opensource",
    "self-hosted"
  ]
}
